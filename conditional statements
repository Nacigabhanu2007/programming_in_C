#include<stdio.h>
int main()
{
        int choice,a,b;
        printf("1-addition \n");
        printf("2-subtraction \n");
        printf("3-multiplication \n");
        printf("4-division \n");
        printf("5-modulo \n");
        printf("enter the choice");
        scanf("%d",&choice);
        printf("enter a,b");
        scanf("%d%d",&a,&b);
        switch(choice)
        {
                case 1:
                        printf("addition res:%d",a+b);
                        break;
                case 2:
                        printf("subtraction res:%d",a-b);
                        break;
                case 3:
                        printf("multiplication res:%d",a*b);
                        break;
                case 4:
                        printf("division res:%d",a/b);
                        break;
                case 5:
                        printf("modulo res:%d",a%b);
                        break;
                default:
                        printf("invalid choice");
        }
        printf("\n finished/n");
        return 0;

}
  
