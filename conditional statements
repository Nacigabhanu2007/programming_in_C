#include<stdio.h>
int main()
{
        int num;
        printf("enter the num");
        scanf("%d",&num);
        if(num%5==0 && num%2!=0)
        {
                printf("num is divisible by 5 and not a even number");
        }
        else if(num%5==0 && num%2==0)
        {
                printf("num is divisible by 5 and a even number");
        }
        else if(num%5!=0 && num%2==0)
        {
                printf("num is not  divisible by 5 and a even number");
        }
        else if(num%5!=0 && num%2!=0)
        {
                printf("num is not divisible by 5 and not a even number");
        }
        else
        {
                printf("invalid number");
        }
        printf("\nfinished");
        return 0;
}

