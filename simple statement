#include<stdio.h>
int main()
{
        float M1,M2,M3,M4,M5,S,avg;
        printf("enter M1,M2,M3,M4,M5");
        scanf("%f%f%f%f%f",&M1,&M2,&M3,&M4,&M5);
        S=M1+M2+M3+M4+M5;
        avg=S/5;
        printf("avg:%f\n",avg);
        return 0;
}

#include<stdio.h>
