#include<stdio.h>
#include<stdlib.h>
struct student
{
   int roll;
   char name[20];
   float marks[5],average;
};
int main()
{
   FILE *fp;
   struct student s[10],temp;
   int n,i,j;
   printf("enter the no of student:\n");
   scanf("%d",&n);
   printf("enter details of%d student(roll,name,marks):\n",n);
   for(i=0;i<n;i++)
   {
      printf("students %d\n",i+1);
      scanf("%d %s",&s[i].roll,s[i].name);
      for(j=0;j<5;j++)
      {
         scanf("%f",&s[i].marks[j]);
      }

      fp=fopen("students.dat","wb");
      if(fp==NULL)
      {
         printf("cannot open file for writing\n");
         exit(0);
      }
      fwrite(s,sizeof(struct student),n,fp);
   }
   fclose(fp);
   fp=fopen("students.dat","rb");
   if(fp==NULL)
      {
         printf("cannot open file for reading\n");
         exit(0);
      }

   printf("\nroll: name: total: average: grade:\n");
   for(i=0;i<n;i++)
   {
      fread(&temp,sizeof(struct student),1,fp);
      float sum=0.0;
      for(j=0;j<5;j++)
      {
         sum+=temp.marks[j];
      }
      float average=sum/5;
      char grade;
      if(average>=90)
      {
         grade='A';
      }
      else if(average>=80)
      {
         grade='B';
      }
      else if(average>=70)
      {
         grade='C';
      }
      else if(average>=60)
      {
         grade='D';
      }
      else
      {
         grade='F';
      }
      printf("%d %s %f %f %c \n",temp.roll,temp.name,sum,average,grade);
   }
   fclose(fp);
   return 0;
}



#include<stdio.h>
#include<stdlib.h>
struct employee
{
   int empid;
   char name[20],design[20];
   float bp,hra,da,gp,tax,pf;
};
int main()
{
   FILE *fp;
   struct employee s[10];
   struct employee t[10];
   int n,i;
   printf("enter the no of employee:\n");
   scanf("%d",&n);
   printf("enter details of%d employee(empid,name,bp,designation):\n",n);
   for(i=0;i<n;i++)
   {
      printf("employee %d\n",i+1);
      scanf("%d %s",&s[i].empid,s[i].name);
      printf("enter bp:\n");
      scanf(" %.2f",&s[i].bp);
      getchar();
      printf("enter designation:\n");
      scanf("%s",&s[i].design);
   }
   fp=fopen("employee.dat","wb");
   if(fp==NULL)
     {
         printf("cannot open file for writing\n");
         exit(0);
     }
      fwrite(s,sizeof(struct employee),n,fp);
   fclose(fp);
   fp=fopen("employee.dat","rb");
   if(fp==NULL)
      {
         printf("cannot open file for reading\n");
         exit(0);
      }

   printf("\nempid: name: designation: gross salary:\n");
   for(i=0;i<n;i++)
   {
      fread(&t[i],sizeof(t[i]),1,fp);

         if(strcmp(t[i].design,"manager")==0)
         {
            t[i].hra=t[i].bp*0.30;
            t[i].da=t[i].bp*0.50;
            t[i].tax=t[i].bp*0.10;
            t[i].pf=t[i].bp*0.12;
            t[i].gp=t[i].bp+t[i].da+t[i].hra-t[i].tax-t[i].pf;
         }
         else if(strcmp(t[i].design,"assistant manager")==0)
         {
            t[i].hra=t[i].bp*0.25;
            t[i].da=t[i].bp*0.40;
            t[i].tax=t[i].bp*0.10;
            t[i].pf=t[i].bp*0.12;
            t[i].gp=t[i].bp+t[i].da+t[i].hra-t[i].tax-t[i].pf;
         }
         else if(strcmp(t[i].design,"clerk")==0)
         {
            t[i].hra=t[i].bp*0.20;
            t[i].da=t[i].bp*0.30;
            t[i].tax=t[i].bp*0.10;
            t[i].pf=t[i].bp*0.12;
            t[i].gp=t[i].bp+t[i].da+t[i].hra-t[i].tax-t[i].pf;
         }
         else
         {
            printf("invalid designation\n");
         }
      printf("\n %d %s %s %.2f \n",t[i].empid,t[i].name,t[i].design,t[i].gp);
   }
   fclose(fp);
   return 0;
}
