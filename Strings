#include<stdio.h>
#include<ctype.h>
int main()
{
   char str[100];
   int i=0;
   int alphabets=0,digits=0,spaces=0,special=0;
   printf("\nenter the string:");
   fgets(str,sizeof(str),stdin);
   while(str[i]!='\0')
   {
      if(isalpha(str[i]))
      {
         alphabets++;
      }
      else if(isdigit(str[i]))
      {
         digits++;
      }
      else if(isspace(str[i]))
      {
         spaces++;
      }
      else
      {
         special++;
      }
      i++;
   }
   printf("\nalphabets:%d,digits:%d,spaces:%d,special:%d",alphabets,digits,spaces,special);
   return 0;
}


#include<stdio.h>
int main()
{
   char a[20];
   int i=0,vowels=0,characters=0,consonants=0,words=0;
   printf("\nenter the string:");
   fgets(a,sizeof(a),stdin);
   while(a[i]!='\0')
   {
      if(a[i]=='A'||a[i]=='I'||a[i]=='E'||a[i]=='O'||a[i]=='U'||a[i]=='a'||a[i]=='e'||a[i]=='i'||a[i]=='o'||a[i]=='u')
      {
         vowels++;
      }
      else if((a[i]>='a'&&a[i]<='z')||(a[i]>='A'&&a[i]<='Z'))
