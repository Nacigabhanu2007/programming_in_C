#include<stdio.h>
#include<string.h>
int main()
{
   char str[10][20],temp[50];
   int i,j,n;
   printf("enter the num of string");
   scanf("%d",&n);
   getchar();
   printf("\nenter the %d string:\n",n);
   for(i=0;i<n;i++)
   {
      scanf("%s",&str[i]);
   }
   for(i=0;i<n-1;i++)
   {
      for(j=0;j<n-1-i;j++)
      {
         if(strcmp(str[j],str[j+1])>0)
         {
            strcpy(temp,str[j]);
            strcpy(str[j],str[j+1]);
            strcpy(str[j+1],temp);
         }
      }
   }
   printf("\nstring in alphabetical order:\n");
   for(i=0;i<n;i++)
   {
      printf("%s\n",str[i]);
   }
   return 0;
}



