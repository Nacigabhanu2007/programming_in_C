#include<stdio.h>
int main()
{
   char a[30];
   int i,len=0,flag=0;
   printf("\nenter the string:");
   getchar();
   fgets(a,sizeof(a),stdin);
   for(i=0;a[i]!='\0';i++)
   {
      len++;
   }
   len=len-1;
   for(i=0;i<len/2;i++)
   {
      if(a[i]!=a[len-i-1])
      {
         flag=1;
         break;
      }
   }
   if(flag==0)
   {
      printf("\nIt is  a palindrome.\n");
   }
   else
   {
      printf("\nIt is not a palindrome.\n");
   }
   return 0;
}


