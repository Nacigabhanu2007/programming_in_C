#include<stdio.h>
int power(int x,int y)
{
   if(y==0)
   {
      return 1;
   }
   else
   {
      return x*power(x,y-1);
   }
}
   int main()
   {
      int b,e,res;
      printf("enter b,e");
      scanf("%d%d",&b,&e);
      if(b<0&&e<0)
      {
         printf("invalid number");
      }
      else
      {
         res=power(b,e);
         printf("\n%d",res);
      }
      printf("\nfinished\n");
      return 0;
   }

#include<stdio.h>
int fibo(int n);
int fibo( int n)
{
   if(n==0)
   {
      return 0;
   }
   else if(n==1)
   {
      return 1;
   }
   else
   {
      return fibo(n-1)+fibo(n-2);
   }
}
int main()
{
   int n,i;
   printf("enter n");
   scanf("%d",&n);
   for(i=0;i<=n;i++)
   {
      printf("%d\t",fibo(i));
   }
   printf("\nfinished\n");
   return 0;
}


