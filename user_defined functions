int add(int a,int b)
{
   int res;
   res=a+b;
   return res;
}
int sub(int a,int b)
{
   int res;
   res=a-b;
   return res;
}
int multi(int a,int b)
{
   int res;
   res=a*b;
   return res;
}
int div(int a,int b)
{
   int res;
   res=a/b;
   return res;
}
int modulo(int a,int b)
{
   int res;
   res=a%b;
   return res;
}
