#include<stdio.h>
#include<stdlib.h>
int main()
{
   int *a,*aa,n,sum=0,i;
   printf("enter n:\n");
   scanf("%d",&n);
   a=(int*)malloc(n*sizeof(int));
   if(a==NULL)
   {
      printf("memory is not allocated\n");
      exit(0);
   }
   printf("enter the elements:\n");
   for(i=0;i<n;i++)
   {
      scanf("%d",&a[i]);
