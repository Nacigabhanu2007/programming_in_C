#include<stdio.h>
int main()
{
   FILE *fp;
   char ch;
   int c=0,l=0;
   fp=fopen("input.txt","r");
   if(fp==NULL)
   {
      printf("file cannot be opened\n");
      return 1;
   }
   while((ch=fgetc(fp))!=EOF)
   {

      if(ch!='\n' && ch!='\r' && ch!='\t')
         c++;
      if(ch=='\n')
         l++;
   }
   fclose(fp);
   printf("total character:%d\n total line:%d\n",c,l);
   return 0;
}



#include<stdio.h>
#include<stdlib.h>
int main()
{
   FILE *fp1,*fp2;
   char ch;
   fp1=fopen("source.txt","r");
   if(fp1==NULL)
   {
      printf("source file cannot be opened\n");
      exit(0);
   }
   fp2=fopen("dest.txt","w");
   if(fp2==NULL)
   {
      printf("destination file cannot be open\n");
      fclose(fp1);
      exit(0);
   }
   while((ch=fgetc(fp1))!=EOF)
   {
      fputc(ch,fp2);
   }
   printf("file copied successfully\n");
   fclose(fp1);
   fclose(fp2);
   return 0;
}



#include<stdio.h>
#include<stdlib.h>
int main()
{
   FILE *fp;
   int roll,n,j,i;
   char name[20],grade;
   float marks[5],average;
   printf("enter no of students:\n");
   scanf("%d",&n);
   fp=fopen("students.txt","w");
   if(fp==NULL)
   {
      printf("cannot open file for writing\n");
      exit(0);
   }
   printf("enter details of %d students(roll,name,marks):\n",n);
   for(i=0;i<n;i++)
   {
      printf("students %d:\n",i+1);
      scanf("%d%s",&roll,name);
      for(j=0;j<5;j++)
      {
         scanf("%f",&marks[j]);
      }
      fprintf(fp,"%d %s %f %f %f %f %f\n",roll,name,marks[0],marks[1],marks[2],marks[3],marks[4]);
   }
   fclose(fp);
   fp=fopen("students.txt","r");
   if(fp==NULL)
   {
      printf("cannot open file\n");
      exit(0);
   }
   printf("\nroll:\tname:\ttotal:\tgrade:\n");
   for(i=0;i<n;i++)
   {
      if(fscanf(fp,"%d %s %f %f %f %f %f\n",&roll,name,&marks[0],&marks[1],&marks[2],&marks[3],&marks[4])!=7)
      {
         break;
      }
      float sum=0.0;
      for(j=0;j<5;j++)
      {
         sum+=marks[j];
      }
      average=sum/5;
      if(average>=90)
         grade='A';
      else if(average>=80)
         grade='B';
      else if(average>=70)
         grade='C';
      else if(average>=60)
         grade='D';
      else
         grade='F';
      printf("%d %s %f %f %c\n",roll,name,sum,average,grade);
   }
      fclose(fp);
      return 0;
}
