#include<math.h>
int main()
{
   int n,rem,c=0,s=0,ori;
   printf("enter n");
   scanf("%d",&n);
   ori=n;
   while(n>0)
   {
      rem=n%10;
      c=c+1;
      n=n/10;
   }
   n=ori;
   while(n>0)
   {
      rem=n%10;
      s=s+pow(rem,c);
      n=n/10;

   }
   if(s==ori)
   {
      printf("%d is armstrong number",ori);
   }
   else
   {
      printf("%d is not armstrong number",ori);
   }
   printf("\n finished");
   return 0;
}

#include<stdio.h>
int main()
{
   int i=2,n,flag;
   printf("enter n");
   scanf("%d",&n);
   while(i<n)
   {
      if(n%i==0)
      {
         flag=1;
         break;
      }
      i=i+1;
   }
   if(flag==0&&n>1)
   {
      printf("%d is prime number",n);
   }
   else
   {
      printf("%d is not prime number",n);
   }
   printf("\nfinished");
   return 0;
}

