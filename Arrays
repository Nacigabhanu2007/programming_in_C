#include<stdio.h>
int main()
{
   int a[100],n,i,j,temp;
   printf("enter elements");
   scanf("%d",&n);
   printf("enter the %d elements:",n);
   for(i=0;i<n;i++)
   {
      scanf("%d",&a[i]);
   }
   for(i=0;i<n-1;i++)
   {
      for(j=0;j<n-i-1;j++)
      {
         if(a[j]>a[j+1])
         {
            temp=a[j];
            a[j]=a[j+1];
            a[j+1]=temp;
         }
      }
   }
   printf("sorted elements");
   for(i=0;i<n;i++)
   {
      printf("%d\t",a[i]);
   }
   printf("\nfinished\n");
   return 0;
}


