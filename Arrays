#include<stdio.h>
int main()
{
   int a[10][10],b[10][10],sum[10][10];
   int r,c,i,j;
   printf("enter no.of rows and columns");
   scanf("%d%d",&r,&c);
   printf("\nenter elements of first matrix");
   for(i=0;i<r;i++)
   {
      for(j=0;j<c;j++)
      {
         scanf("%d",&a[i][j]);
      }
   }
   printf("\nenter elements of second matrix");
   for(i=0;i<r;i++)
   {
      for(j=0;j<c;j++)
      {
         scanf("%d",&b[i][j]);
      }
   }
   for(i=0;i<r;i++)
   {
      for(j=0;j<c;j++)
      {
         sum[i][j]=a[i][j]+b[i][j];
      }
   }
   printf("\nsum of two matrices:\n");
   for(i=0;i<r;i++)
   {
      for(j=0;j<c;j++)
      {
         printf("%d\t",sum[i][j]);
      }
      printf("\n");
   }
   return 0;
}


#include<stdio.h>
int main()
{
   int a[10][10],trans[10][10];
   int r,c,i,j;
   printf("enter no.of rows and columns");
   scanf("%d%d",&r,&c);
   printf("\nenter elements of first matrix");
   for(i=0;i<r;i++)
   {
      for(j=0;j<c;j++)
      {
         scanf("%d",&a[i][j]);
      }
   }
   for(i=0;i<r;i++)
   {
      for(j=0;j<c;j++)
      {
         trans[j][i]=a[i][j];
      }
   }
   printf("\ntranspose of matrix:\n");
   for(i=0;i<r;i++)
   {
      for(j=0;j<c;j++)
      {
         printf("%d\t",trans[j][i]);
      }
      printf("\n");
   }
   return 0;
}


