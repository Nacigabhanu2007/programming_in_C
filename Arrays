#include<stdio.h>
int main()
{
   float marks[10],tot=0.0,avg;
   int n,i;
   printf("enter tot no.of students");
   scanf("%d", &n);
   printf("enter marks");
   for(i=0;i<n;i++)
   {
      scanf("%f",&marks[i]);
   }
   for(i=0;i<n;i++)
   {
      tot=tot+marks[i];
   }
   avg=tot/n;
   printf("avg:%f,tot:%f",avg,tot);
   return 0;
}


